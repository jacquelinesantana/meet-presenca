{
  "manifest_version": 3,
  "name": "Meet Presença",
  "short_name": "Meet Presença",
  "version": "1.6.0",
  "description": "Captura nome e tempo de permanência dos participantes de reuniões do Google Meet (com melhor esforço para e-mails). Os dados ficam somente no seu navegador.",
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Abrir Meet Presença"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "lib/utils.js",
        "lib/constants.js",
        "content/noise-patterns.js",
        "content/selectors.js",
        "content/tracker.js",
        "content/content.js"
      ],
      "css": ["content/content.css"]
    }
  ]
}
